{
  "name": "animx",
  "version": "3.11.0",
  "description": "Zero-dependency animation engine",
  "main": "dist/animx.js",
  "style": "dist/animx.css",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build:full": "vite build",
    "build:core": "vite build -c vite.core.config.js",
    "build:studio": "vite build -c vite.studio.config.js",
    "build": "npm run build:full && npm run build:core && npm run build:studio && node build-post.js",
    "verify:dist": "node scripts/verify-dist.js",
    "size": "node scripts/size-check.js",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true });\"",
    "test": "node tests/run.js"
  },
  "keywords": [
    "animation",
    "zero-dependency",
    "library"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "sass": "^1.69.0",
    "terser": "^5.24.0",
    "vite": "^5.0.0"
  }
}
